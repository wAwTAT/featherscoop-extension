{
  "manifest_version": 3,
  "name": "FeatherScoop — 飞书文档附件与正文下载器",
  "version": "1.2.2",
  "description": "一键保存飞书 / Lark 文档中的附件与正文（Markdown），复用浏览器登录态，无需 Cookie、Token 或命令行。",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FeatherScoop",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["scripting", "downloads", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.feishu.cn/*",
    "*://*.larksuite.com/*",
    "*://*.larkoffice.com/*"
  ]
}
